# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
build/
dist/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/

# --- Data: raw sources are restricted and must not be committed ---
data/raw/*
!data/raw/.gitkeep

# --- Models (trained artifacts are large / regenerable) ---
models/*
!models/.gitkeep
artifacts/models/*
!artifacts/models/.gitkeep

# --- Local index store (regenerable) ---
artifacts/index/

# --- OS ---
.DS_Store
Thumbs.db
