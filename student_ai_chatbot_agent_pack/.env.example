# ---------------------------------------------------------------------------
# Student AI Chatbot — example environment.
# Copy to `.env` and fill values. NEVER commit a real `.env` or real secrets.
# The prototype runs fully offline with the defaults below (no DB, no API keys).
# See CONFIG_REFERENCE.md for the authoritative list.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Database (OPTIONAL) ---
# Leave empty to use the offline local NumPy vector store (default).
# Set to a pgvector-enabled PostgreSQL to use the DB-backed store.
# DATABASE_URL=postgresql+psycopg://campusbot:campusbot@localhost:5432/campusbot
DATABASE_URL=

# --- Intent model ---
INTENT_MODEL_NAME=distilbert-base-uncased
INTENT_MAX_LENGTH=128
INTENT_SEED=42
# Path to a fine-tuned intent model dir; when absent the deterministic
# lexical fallback classifier is used.
INTENT_MODEL_DIR=artifacts/models/intent

# --- Embedding model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# hash = deterministic offline embeddings (default, no download)
# sentence-transformers = real MiniLM (requires the `ml` extra + cached model)
# auto = try MiniLM from local cache only, else fall back to hash
EMBEDDING_MODE=auto

# --- Retrieval ---
LEXICAL_TOP_K=10
DENSE_TOP_K=10
FINAL_TOP_K=5
# Fusion-score floor below which evidence is discarded and the system abstains.
# Calibrate on validation data (scripts/evaluate_retrieval.py --calibrate).
MIN_FUSED_SCORE=0.30
MIN_DENSE_SCORE=0.0
MIN_LEXICAL_SCORE=0.0

# --- LLM ---
# gemini | anthropic | extractive (deterministic offline grounded generator)
LLM_PROVIDER=extractive
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- API controls ---
MAX_QUERY_CHARS=2000
REQUEST_TIMEOUT_SECONDS=20
# Admin token for /api/admin/* in non-development environments.
ADMIN_API_TOKEN=

# --- Audit ---
KNOWLEDGE_BASE_VERSION=campus-kb-demo-v1
STORE_RAW_QUERY=false

# --- Knowledge base / index paths ---
INDEX_DIR=artifacts/index
SOURCE_REGISTRY_PATH=data/fixtures/source_registry.demo.json
