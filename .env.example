# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NVIDIA NIM / NeMo API Configurations (For Production NIM Integration)
NVIDIA_API_KEY=""
NVIDIA_EMBEDDING_MODEL="nvidia/nv-embedqa-e5-v5"
NVIDIA_RERANKER_MODEL="nvidia/reranking-mistral-4b"
NVIDIA_LLM_MODEL="meta/llama-3.1-70b-instruct"

# Cloudflare Vectorize & Workers AI (Distributed Edge Vector Database)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_VECTORIZE_INDEX="student-curriculum-index"
CLOUDFLARE_EMBEDDING_MODEL="@cf/baai/bge-base-en-v1.5"

# NLP & RAG Thresholds
INTENT_CONFIDENCE_THRESHOLD="0.55"
RETRIEVAL_SCORE_THRESHOLD="0.45"
RERANKER_TOP_K="4"
TOP_K_RETRIEVAL="10"

# Application Settings
PORT="3000"
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"
FRONTEND_URL="http://localhost:3000"

